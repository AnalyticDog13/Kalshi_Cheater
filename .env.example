# =============================================================================
# KALSHI WEATHER TRADER — Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to git.
# =============================================================================

# Trading mode: "demo" for paper trading, "live" for real money.
# Switching to "live" ALSO requires the --live flag at runtime.
TRADING_MODE=demo

# --- Kalshi Demo Credentials (paper trading) ---
# Get these from https://demo.kalshi.com → Account → API
KALSHI_DEMO_API_KEY_ID=your_demo_key_id_here
KALSHI_DEMO_PRIVATE_KEY_PATH=/path/to/demo_private_key.pem

# --- Kalshi Live Credentials (real money — fill in only when ready) ---
KALSHI_LIVE_API_KEY_ID=
KALSHI_LIVE_PRIVATE_KEY_PATH=

# --- Anthropic (Claude API) ---
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Notifications ---
# Create a bot via @BotFather on Telegram, then get your chat ID.
# Set method to "log_only" if you don't want Telegram yet.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional overrides ---
LOG_LEVEL=INFO
DB_PATH=./data/trades.db
CALIBRATION_DB_PATH=./data/calibration.db
STATION_BIAS_DB_PATH=./data/station_bias.db
